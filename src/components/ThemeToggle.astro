---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class:list={[
    "theme-toggle grid size-8 place-items-center rounded-md border border-border text-muted-foreground",
    className,
  ]}
  aria-label="Switch to dark theme"
>
  <svg
    class="icon-sun size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <svg
    class="icon-moon size-4"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path
      d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"
    ></path>
  </svg>
</button>

<script>
  const sync = (dark: boolean) => {
    for (const el of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
      el.setAttribute(
        "aria-label",
        dark ? "Switch to light theme" : "Switch to dark theme",
      );
    }
  };

  sync(document.documentElement.classList.contains("dark"));

  for (const el of document.querySelectorAll<HTMLElement>("[data-theme-toggle]")) {
    el.addEventListener("click", () => {
      const dark = document.documentElement.classList.toggle("dark");
      localStorage.setItem("gomason-theme", dark ? "dark" : "light");
      sync(dark);
    });
  }
</script>
