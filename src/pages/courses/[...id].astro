---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Logo from "../../components/Logo.astro";
import MarkComplete from "../../components/MarkComplete.tsx";
import ThemeToggle from "../../components/ThemeToggle.astro";
import { PARTS } from "../../content.config";

export async function getStaticPaths() {
  const lessons = (await getCollection("lessons")).sort(
    (a, b) => a.data.order - b.data.order,
  );

  return lessons.map((lesson, i) => ({
    params: { id: lesson.id },
    props: {
      lesson,
      prev: lessons[i - 1] ?? null,
      next: lessons[i + 1] ?? null,
    },
  }));
}

const { lesson, prev, next } = Astro.props;
const { Content } = await render(lesson);
const part = PARTS.find((p) => p.id === lesson.data.part);

const site = Astro.site ?? new URL("/", Astro.url);
const pageUrl = new URL(Astro.url.pathname, site).href;

const learningResource = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: lesson.data.title,
  description: lesson.data.summary,
  url: pageUrl,
  inLanguage: "en",
  isAccessibleForFree: true,
  learningResourceType: "Lesson",
  educationalLevel: "Beginner",
  timeRequired: `PT${lesson.data.minutes}M`,
  teaches: lesson.data.topics,
  position: lesson.data.order,
  isPartOf: {
    "@type": "Course",
    name: "GoMason — Learn Go by building an ORM",
    url: site.href,
  },
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "GoMason", item: site.href },
    {
      "@type": "ListItem",
      position: 2,
      name: part?.title ?? "Courses",
      item: new URL("/#curriculum", site).href,
    },
    { "@type": "ListItem", position: 3, name: lesson.data.title, item: pageUrl },
  ],
};
---

<Layout
  title={`${lesson.data.title} — GoMason`}
  description={lesson.data.summary}
  ogType="article"
  noindex={lesson.data.draft}
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(learningResource)}
    />
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(breadcrumbs)}
    />
  </Fragment>

  <div class="mx-auto max-w-3xl px-6">
    <header class="flex items-center justify-between py-6">
      <a href="/" class="transition-opacity hover:opacity-80">
        <Logo size={26} wordmark />
      </a>
      <nav class="flex items-center gap-4">
        <a
          href="/#curriculum"
          class="text-sm text-muted-foreground transition-colors hover:text-foreground"
          >All courses</a
        >
        <ThemeToggle />
      </nav>
    </header>

    <main class="pb-20">
      <div class="border-t border-border pt-10">
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-cyan">
          {part?.title} &middot; Course {String(lesson.data.order).padStart(2, "0")}
        </p>
        <h1 class="mt-4 text-4xl leading-tight tracking-tight sm:text-5xl">
          {lesson.data.title}
        </h1>
        <p class="mt-4 max-w-[60ch] text-lg text-muted-foreground">
          {lesson.data.summary}
        </p>
        <p class="mt-5 font-mono text-[11px] uppercase tracking-[0.12em] text-mortar">
          {lesson.data.minutes} min &middot; {lesson.data.topics.join(" · ")}
        </p>
      </div>

      {
        lesson.data.draft ? (
          <div class="mt-10 rounded-lg border border-border bg-card p-6">
            <p class="font-mono text-xs uppercase tracking-[0.14em] text-mortar">
              Not written yet
            </p>
            <p class="mt-3 text-muted-foreground">
              This course is outlined but unwritten. The summary above is the
              contract: when it ships, it ends with working, tested code.
            </p>
          </div>
        ) : (
          <article class="prose mt-10">
            <Content />
          </article>
        )
      }

      {
        !lesson.data.draft && (
          <div class="mt-12 border-t border-border pt-8">
            <MarkComplete client:load lessonId={lesson.id} />
          </div>
        )
      }

      <nav class="mt-12 grid gap-3 border-t border-border pt-8 sm:grid-cols-2">
        {
          prev ? (
            <a
              href={`/courses/${prev.id}`}
              class="group rounded-lg border border-border p-4 transition-colors hover:bg-muted"
            >
              <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-mortar">
                ← Course {String(prev.data.order).padStart(2, "0")}
              </span>
              <span class="mt-1.5 block font-heading text-lg tracking-tight">
                {prev.data.title}
              </span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a
              href={`/courses/${next.id}`}
              class="group rounded-lg border border-border p-4 text-right transition-colors hover:bg-muted sm:col-start-2"
            >
              <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-mortar">
                Course {String(next.data.order).padStart(2, "0")} →
              </span>
              <span class="mt-1.5 block font-heading text-lg tracking-tight">
                {next.data.title}
              </span>
            </a>
          )
        }
      </nav>
    </main>

    <footer class="flex flex-wrap items-center justify-between gap-4 border-t border-border py-8 text-sm text-muted-foreground">
      <Logo size={20} />
      <p>Built in the open. MIT licensed.</p>
    </footer>
  </div>

  <script>
    for (const pre of document.querySelectorAll<HTMLPreElement>(".prose pre")) {
      if (pre.dataset.language === "text") continue;
      const source = pre.querySelector("code")?.innerText ?? "";

      const button = document.createElement("button");
      button.type = "button";
      button.className = "copy-btn";
      button.textContent = "Copy";
      button.setAttribute("aria-label", "Copy code to clipboard");

      let timer: ReturnType<typeof setTimeout>;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(source);
        } catch {
          return;
        }
        button.textContent = "Copied";
        button.dataset.done = "true";
        clearTimeout(timer);
        timer = setTimeout(() => {
          button.textContent = "Copy";
          delete button.dataset.done;
        }, 1600);
      });

      pre.appendChild(button);
    }
  </script>
</Layout>
